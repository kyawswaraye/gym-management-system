    "components": {
        "schemas": {
            "CurrentUserData": {
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/CurrentUserIdentity"
                    },
                    "gym": {
                        "$ref": "#/components/schemas/SelectedGym"
                    },
                    "gym_membership": {
                        "$ref": "#/components/schemas/SelectedMembership"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "features": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FeatureEntitlement"
                        }
                    },
                    "authz_version": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "authz_version",
                    "features",
                    "gym",
                    "gym_membership",
                    "permissions",
                    "user"
                ]
            },
            "CurrentUserEnvelope": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "default": true
                    },
                    "data": {
                        "$ref": "#/components/schemas/CurrentUserData"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "data",
                    "message"
                ]
            },
            "CurrentUserIdentity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "first_name",
                    "id",
                    "last_name"
                ]
            },
            "DirectLoginData": {
                "type": "object",
                "properties": {
                    "access_token": {
                        "type": "string"
                    },
                    "access_expires_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "refresh_token": {
                        "type": "string"
                    },
                    "refresh_expires_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "requires_gym_selection": {
                        "type": "boolean",
                        "default": false
                    },
                    "available_gym_memberships": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/GymMembershipChoice"
                        }
                    }
                },
                "required": [
                    "access_expires_at",
                    "access_token",
                    "available_gym_memberships",
                    "refresh_expires_at",
                    "refresh_token"
                ]
            },
            "DirectLoginEnvelope": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "default": true
                    },
                    "data": {
                        "$ref": "#/components/schemas/DirectLoginData"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "data",
                    "message"
                ]
            },
            "ErrorDetail": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "code",
                    "message"
                ]
            },
            "ErrorEnvelope": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "default": false
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetail"
                    },
                    "request_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "error",
                    "request_id"
                ]
            },
            "FeatureEntitlement": {
                "type": "object",
                "properties": {
                    "feature__code": {
                        "type": "string"
                    },
                    "limit_value": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "required": [
                    "feature__code",
                    "limit_value"
                ]
            },
            "GymDisplay": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "name"
                ]
            },
            "GymMembershipChoice": {
                "type": "object",
                "properties": {
                    "gym_membership_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "gym_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "gym": {
                        "$ref": "#/components/schemas/GymDisplay"
                    }
                },
                "required": [
                    "gym",
                    "gym_id",
                    "gym_membership_id"
                ]
            },
            "GymMembershipListEnvelope": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "default": true
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/GymMembershipRow"
                        }
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "data",
                    "message"
                ]
            },
            "GymMembershipRow": {
                "type": "object",
                "properties": {
                    "gym_membership_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "gym_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "gym": {
                        "$ref": "#/components/schemas/GymDisplay"
                    },
                    "status": {
                        "type": "string"
                    },
                    "is_owner": {
                        "type": "boolean"
                    },
                    "authz_version": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "authz_version",
                    "gym",
                    "gym_id",
                    "gym_membership_id",
                    "is_owner",
                    "status"
                ]
            },
            "HealthData": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "HealthEnvelope": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "default": true
                    },
                    "data": {
                        "$ref": "#/components/schemas/HealthData"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "data",
                    "message"
                ]
            },
            "LoginEnvelope": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/DirectLoginEnvelope"
                    },
                    {
                        "$ref": "#/components/schemas/SelectionLoginEnvelope"
                    }
                ]
            },
            "LoginInputRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "mfa_code": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
