# Production BFF name inventory. Copy off the repository.
# NEXT_PUBLIC_OBJECT_ORIGINS is a public HTTPS origin list baked at image
# build time. Production virtual-hosted S3 signs
# https://{bucket}.s3.ap-southeast-1.amazonaws.com — bake that exact origin,
# not the path-style https://s3.ap-southeast-1.amazonaws.com API setting.
# Set repository variable NEXT_PUBLIC_OBJECT_ORIGINS before image-release.
# Do not put server secrets in that build argument. A new web image is required
# when the bucket origin changes; runtime Compose env does not update the client.

DJANGO_API_URL=http://api:8000
BFF_SHARED_SECRET=
APP_ORIGINS=https://app.example.com
ACCESS_EXPIRED_CODE=ACCESS_TOKEN_EXPIRED
NEXT_PUBLIC_OBJECT_ORIGINS=https://replace-with-approved-bucket.s3.ap-southeast-1.amazonaws.com
