# Production BFF name inventory. Copy off the repository.
# NEXT_PUBLIC_OBJECT_ORIGINS is a public HTTPS origin list baked at image
# build time. Do not put server secrets in that build argument.

DJANGO_API_URL=http://api:8000
BFF_SHARED_SECRET=
APP_ORIGINS=https://app.example.com
ACCESS_EXPIRED_CODE=ACCESS_TOKEN_EXPIRED
NEXT_PUBLIC_OBJECT_ORIGINS=https://s3.ap-southeast-1.amazonaws.com
