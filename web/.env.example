# Server-only. Do not expose these values with a NEXT_PUBLIC_ prefix.
DJANGO_API_URL=http://127.0.0.1:8000
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters

# Exact browser origins permitted to mutate authentication state.
APP_ORIGINS=http://localhost:3000

# Stable Django error code that alone permits one refresh and retry.
# This must match the backend's documented contract before integration.
ACCESS_EXPIRED_CODE=ACCESS_TOKEN_EXPIRED

# Use true only for isolated http://localhost development.
ALLOW_INSECURE_LOCALHOST_COOKIES=true
