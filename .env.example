# Copy to .env and replace every placeholder. Never commit .env.
# This file is enough for: make db-up, make migrate, and PostgreSQL verification.

# PostgreSQL 18.6
POSTGRES_DB=gym_platform
POSTGRES_ADMIN_USER=gym_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password
POSTGRES_MIGRATION_USER=gym_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-local-migration-password
POSTGRES_RUNTIME_USER=gym_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-local-runtime-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django database settings (aligned with backend/config)
DB_NAME=gym_platform
DB_HOST=localhost
DB_PORT=5432
DATABASE_ROLE_MODE=runtime
MIGRATION_DB_USER=gym_migration
MIGRATION_DB_PASSWORD=replace-with-local-migration-password
RUNTIME_DB_USER=gym_runtime
RUNTIME_DB_PASSWORD=replace-with-local-runtime-password
TEST_DB_USER=gym_admin
TEST_DB_PASSWORD=replace-with-local-admin-password
RUN_POSTGRESQL_TESTS=1

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LISTEN_HOST=127.0.0.1
JWT_ISSUER=gym-platform-api
JWT_STAFF_AUDIENCE=gym-platform
JWT_MEMBER_AUDIENCE=gym-platform-member
# Web and iOS Google client IDs for member app sign-in, comma-separated. Not the Android client ID.
GOOGLE_OAUTH_CLIENT_IDS=
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_CLOCK_SKEW_SECONDS=30
JWT_KEY_ID=local-development-key
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
REFRESH_TOKEN_PEPPER=replace-with-high-entropy-secret
MFA_TOKEN_PEPPER=replace-with-a-separate-high-entropy-secret
MFA_ENCRYPTION_KEY=replace-with-a-separate-high-entropy-encryption-secret
FINANCE_IDEMPOTENCY_ENCRYPTION_KEY=replace-with-a-different-high-entropy-encryption-secret
MFA_ISSUER=Gym Management System
MFA_CHALLENGE_TTL_SECONDS=300
MFA_ENROLLMENT_TTL_SECONDS=600
MFA_STEP_UP_TTL_SECONDS=600
INVITATION_TOKEN_PEPPER=replace-with-a-separate-high-entropy-secret
INVITATION_TTL_SECONDS=172800
PASSWORD_RESET_TOKEN_PEPPER=replace-with-a-dedicated-reset-pepper
PASSWORD_RESET_TTL_SECONDS=1800
APP_PUBLIC_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
RESEND_API_KEY=

# Trusted BFF-to-Django secret. Minimum 32 characters. Never send to the browser.
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters

# Next.js BFF
DJANGO_API_URL=http://127.0.0.1:8000
APP_ORIGINS=http://localhost:3000
ACCESS_EXPIRED_CODE=ACCESS_TOKEN_EXPIRED
ALLOW_INSECURE_LOCALHOST_COOKIES=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origins only. Production allows the HTTPS entries. HTTP localhost is for local dev.
NEXT_PUBLIC_OBJECT_ORIGINS=http://files.localhost:8088

# Private object storage. Replace every placeholder before a shared environment.
# MinIO and ClamAV publish no host port. The object proxy binds loopback only.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=http://files.localhost:8088
MINIO_SERVER_URL=http://files.localhost:8088
MINIO_BUCKET=gym-private
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=local-dev-only
MINIO_SECRET_KEY=local-dev-only-change
MINIO_SESSION_TOKEN=
MINIO_ADDRESSING_STYLE=path
MINIO_ROOT_USER=local-dev-only
MINIO_ROOT_PASSWORD=local-dev-only-change
MINIO_TIMEOUT_SECONDS=5
OBJECT_STORE_BUCKET_ALLOWLIST=
OBJECT_STORE_ORIGIN_ALLOWLIST=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
OBJECT_PUBLIC_HOST=files.localhost
OBJECT_CORS_ORIGIN=http://localhost:3000
OBJECT_PROXY_PORT=8088

# Browser E2E uses a separate gym_platform_e2e database and these obvious
# placeholders. scripts/e2e.sh applies them; do not copy production secrets here.
# E2E_PLATFORM_PASSWORD=e2e-platform-password
# E2E_PLATFORM_TOTP_SECRET=E2EPLATFORMTOTPPLACEHOLDERAAAAAA
# E2E_OWNER_PASSWORD=e2e-owner-password
# E2E_OWNER_TOTP_SECRET=E2EOWNERTOTPPLACEHOLDERAAAAAAAAA
# E2E_BFF_SHARED_SECRET=e2e-bff-shared-secret-placeholder-32
# E2E file services use compose project gym-e2e-files and these loopback ports.
# E2E_OBJECT_PROXY_PORT=18088
# E2E_MINIO_PORT=19000
# E2E_CLAMAV_PORT=13310
# E2E_MINIO_ACCESS_KEY=local-dev-only
# E2E_MINIO_SECRET_KEY=local-dev-only-change
