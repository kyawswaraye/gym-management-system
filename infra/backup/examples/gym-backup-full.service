# Example only. Copy this unit to /etc/systemd/system before enabling it.
# The command reads active-deployment.json and refuses a zero image digest.
# A nonzero exit is recorded by systemd. Alert inbox delivery is not claimed.

[Unit]
Description=Gym PostgreSQL full backup
Documentation=file:docs/runbooks/phase8-increment-3.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/lib/gym-deploy/production/src/infra/compose
ExecStart=/usr/bin/python3 /usr/local/lib/gym-deploy/run-scheduled-backup.py full
TimeoutStartSec=4h 5min
SuccessExitStatus=0
