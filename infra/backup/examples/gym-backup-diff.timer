# Example only. This timer is not installed until it is copied and enabled.
# Do not enable it until gym-backup bootstrap has exited 0.

[Unit]
Description=Six-hour gym PostgreSQL differential backup

[Timer]
OnCalendar=*-*-* 00/6:20:00 UTC
Persistent=true
Unit=gym-backup-diff.service

[Install]
WantedBy=timers.target
