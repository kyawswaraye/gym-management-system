# Example only. This timer is not installed and is not proof of a backup schedule.
# Do not enable it until gym-backup bootstrap has exited 0.

[Unit]
Description=Example daily gym PostgreSQL full backup

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
Persistent=false
Unit=gym-backup-full.service

[Install]
WantedBy=timers.target
