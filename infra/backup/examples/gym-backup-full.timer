# Example only. This timer is not installed until it is copied and enabled.
# Do not enable it until gym-backup bootstrap has exited 0.
# This timer is not proof of a backup schedule by itself.

[Unit]
Description=Daily gym PostgreSQL full backup

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
Persistent=true
Unit=gym-backup-full.service

[Install]
WantedBy=timers.target
