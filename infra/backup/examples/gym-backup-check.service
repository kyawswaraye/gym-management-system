# Example only. Copy this unit to /etc/systemd/system before enabling it.
# Exit 75 means the non-overlapping backup lock is busy.
# A nonzero status other than 75 is recorded by systemd. Alert delivery is not claimed.

[Unit]
Description=Gym backup freshness check
Documentation=file:docs/runbooks/phase8-increment-3.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/lib/gym-deploy/production/src/infra/compose
ExecStart=/usr/bin/python3 /usr/local/lib/gym-deploy/run-scheduled-backup.py check
TimeoutStartSec=35min
SuccessExitStatus=75
