# Compose interpolation template for infra/compose/docker-compose.prod.yml.
# Copy off the repository and replace every placeholder before any pull or start.
# The sha256 values below are offline format fixtures. They are not published
# image digests and they do not pin a real build. Do not deploy this file.

API_IMAGE=ghcr.io/example/gym-api@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEB_IMAGE=ghcr.io/example/gym-web@sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
POSTGRES_IMAGE=ghcr.io/example/gym-postgres@sha256:1111111111111111111111111111111111111111111111111111111111111111
CADDY_IMAGE=caddy@sha256:2222222222222222222222222222222222222222222222222222222222222222
CLAMAV_IMAGE=clamav/clamav@sha256:3333333333333333333333333333333333333333333333333333333333333333
PROMETHEUS_IMAGE=prom/prometheus@sha256:4444444444444444444444444444444444444444444444444444444444444444
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:5555555555555555555555555555555555555555555555555555555555555555
GRAFANA_IMAGE=grafana/grafana@sha256:6666666666666666666666666666666666666666666666666666666666666666
NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:7777777777777777777777777777777777777777777777777777777777777777
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter@sha256:8888888888888888888888888888888888888888888888888888888888888888
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter@sha256:9999999999999999999999999999999999999999999999999999999999999999

PUBLIC_HOST=app.example.com
ACME_EMAIL=ops@example.com
APP_ORIGINS=https://app.example.com
APP_PUBLIC_URL=https://app.example.com
DEFAULT_FROM_EMAIL=Gym <no-reply@example.com>

POSTGRES_DB=gym_platform
POSTGRES_ADMIN_USER=gym_admin
POSTGRES_ADMIN_PASSWORD=replace-from-secret-store
MIGRATION_DB_USER=gym_migration
MIGRATION_DB_PASSWORD=replace-from-secret-store
RUNTIME_DB_USER=gym_runtime
RUNTIME_DB_PASSWORD=replace-from-secret-store

DJANGO_SECRET_KEY=replace-from-secret-store
JWT_KEY_ID=replace-with-key-id
JWT_PRIVATE_KEY=replace-from-secret-store
JWT_PUBLIC_KEYS=replace-from-secret-store
REFRESH_TOKEN_PEPPER=replace-from-secret-store
MFA_TOKEN_PEPPER=replace-from-secret-store
MFA_ENCRYPTION_KEY=replace-from-secret-store
FINANCE_IDEMPOTENCY_ENCRYPTION_KEY=replace-from-secret-store
INVITATION_TOKEN_PEPPER=replace-from-secret-store
PASSWORD_RESET_TOKEN_PEPPER=replace-from-secret-store
BFF_SHARED_SECRET=replace-from-secret-store
RESEND_API_KEY=replace-from-secret-store
FCM_PROJECT_ID=replace-with-project-id
FCM_SERVICE_ACCOUNT_JSON=replace-from-secret-store
PUSH_TOKEN_ENCRYPTION_KEY=replace-from-secret-store
PUSH_TOKEN_FINGERPRINT_PEPPER=replace-from-secret-store
MINIO_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
MINIO_PUBLIC_URL=https://s3.ap-southeast-1.amazonaws.com
MINIO_BUCKET=replace-with-approved-bucket
MINIO_ACCESS_KEY=replace-from-secret-store
MINIO_SECRET_KEY=replace-from-secret-store
MINIO_SESSION_TOKEN=
OBJECT_STORE_BUCKET_ALLOWLIST=replace-with-approved-bucket
OBJECT_STORE_ORIGIN_ALLOWLIST=https://s3.ap-southeast-1.amazonaws.com

# Backup storage is a separate approval from the application object store.
# These placeholders are not application credentials and are not a live repository.
BACKUP_S3_ENDPOINT=https://backup-storage.example
BACKUP_S3_REGION=replace-with-approved-backup-region
BACKUP_S3_BUCKET=replace-with-approved-backup-bucket
BACKUP_S3_URI_STYLE=host
BACKUP_REPO_PATH=/gym-platform
BACKUP_STANZA=gym
BACKUP_REPO_CIPHER_PASS_FILE=../environments/production/backup-repo-cipher-pass.example
BACKUP_S3_ACCESS_KEY_FILE=../environments/production/backup-s3-access-key.example
BACKUP_S3_SECRET_KEY_FILE=../environments/production/backup-s3-secret-key.example
MONITOR_DB_PASSWORD_FILE=../environments/production/monitor-db-password.example
GRAFANA_ADMIN_PASSWORD_FILE=../environments/production/grafana-admin-password.example
ALERT_SINK_URL_FILE=../environments/production/alert-sink-url.example
