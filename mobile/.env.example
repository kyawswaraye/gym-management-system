# Copy to .env and run npm run env:sync.
# Debug Android emulator: http://10.0.2.2:8000
# Debug iOS simulator: http://localhost:8000
# Release builds must use APP_ENV=release and an https origin.
API_BASE_URL=http://10.0.2.2:8000
APP_ENV=debug
# Public OAuth client IDs. Empty leaves the Google button unconfigured.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
