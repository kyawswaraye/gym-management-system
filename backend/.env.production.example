# Production API name inventory. Copy off the repository and fill from a
# secret store. Empty and placeholder values are not live credentials.
# Compose passes runtime and migration database passwords to different
# containers. Do not put both passwords in one process environment.
# The migration job uses config.settings.migration and receives only
# DJANGO_SECRET_KEY plus the migration database identity. It does not
# receive provider secrets. Names match backend/config/settings.
# Do not invent a second object-store prefix.
# Production isolation is a container-private bind, no API host port, and
# the Caddy member-route allowlist. DJANGO_LISTEN_HOST is not that control.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=app.example.com,api,127.0.0.1

DATABASE_ROLE_MODE=runtime
DB_NAME=gym_platform
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60
RUNTIME_DB_USER=gym_runtime
RUNTIME_DB_PASSWORD=
MIGRATION_DB_USER=gym_migration
MIGRATION_DB_PASSWORD=
WEB_CONCURRENCY=2

JWT_ISSUER=gym-platform-api
JWT_STAFF_AUDIENCE=gym-platform
JWT_MEMBER_AUDIENCE=gym-platform-member
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
REFRESH_TOKEN_PEPPER=
MFA_TOKEN_PEPPER=
MFA_ENCRYPTION_KEY=
FINANCE_IDEMPOTENCY_ENCRYPTION_KEY=
INVITATION_TOKEN_PEPPER=
PASSWORD_RESET_TOKEN_PEPPER=
PASSWORD_RESET_TTL_SECONDS=1800
BFF_SHARED_SECRET=

APP_PUBLIC_URL=https://app.example.com
EMAIL_BACKEND=apps.common.mail.resend.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Gym <no-reply@example.com>

PUSH_BACKEND=fcm
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
PUSH_TOKEN_ENCRYPTION_KEY=
PUSH_TOKEN_FINGERPRINT_PEPPER=

MINIO_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
MINIO_PUBLIC_URL=https://s3.ap-southeast-1.amazonaws.com
MINIO_BUCKET=
MINIO_REGION=ap-southeast-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SESSION_TOKEN=
MINIO_ADDRESSING_STYLE=virtual
OBJECT_STORE_BUCKET_ALLOWLIST=
OBJECT_STORE_ORIGIN_ALLOWLIST=https://s3.ap-southeast-1.amazonaws.com

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
