DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-locally
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=gym_platform
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
DATABASE_ROLE_MODE=runtime
RUNTIME_DB_USER=gym_runtime
RUNTIME_DB_PASSWORD=replace-locally
MIGRATION_DB_USER=gym_migration
MIGRATION_DB_PASSWORD=replace-locally

JWT_ISSUER=gym-platform-api
JWT_STAFF_AUDIENCE=gym-platform
JWT_MEMBER_AUDIENCE=gym-platform-member
JWT_KEY_ID=local-2026-01
JWT_PRIVATE_KEY=
# Format: kid=PEM;;next-kid=PEM. Encode PEM newlines as \n.
JWT_PUBLIC_KEYS=
JWT_CLOCK_SKEW_SECONDS=30
REFRESH_TOKEN_PEPPER=replace-with-high-entropy-secret
BFF_SHARED_SECRET=replace-with-at-least-32-random-characters
DJANGO_LISTEN_HOST=127.0.0.1

# Empty storage settings keep the API from signing URLs until a local stack is configured.
MINIO_ENDPOINT_URL=
MINIO_PUBLIC_URL=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_TIMEOUT_SECONDS=5
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15

# Disposable PostgreSQL verification. Use a CREATEDB role such as gym_admin.
TEST_DB_USER=gym_admin
TEST_DB_PASSWORD=replace-locally
